# 填入 Kimi 开放平台 API Key，不是 Kimi Code 订阅密钥。修改后重启。
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
KIMI_REASONING_EFFORT=low
KIMI_TIMEOUT_MS=90000
PORT=4173
# 本机使用留空；云端填写完整访问来源，如 http://8.147.71.90（不加尾部斜杠）。
PUBLIC_ORIGIN=
# 共享业务记录目录；本机留空使用项目 var/，云端建议 /var/lib/anzhen-fde。
DATA_DIR=
